{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "declaration": false,
    "emitDeclarationOnly": false,
    "sourceMap": false,
    "allowJs": false,
    "removeComments": false,
    "allowImportingTsExtensions": false
  },
  "include": [
    "apps/**/*.ts",
    "bin/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["tests", "dist", "node_modules", ".bun-check"]
}
